# --- Required ---
ANTHROPIC_API_KEY=

# --- Embeddings: "voyage-4-lite" (needs VOYAGE_API_KEY, recommended) or "e5-large" (local ONNX, no key, ~2GB download) ---
EMBED_MODEL=voyage-4-lite
VOYAGE_API_KEY=

# --- Optional sources (feature disabled when empty) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# X/Twitter via bird CLI (browser cookies from a logged-in x.com session)
AUTH_TOKEN=
CT0=

# --- Delivery ---
SLACK_WEBHOOK_URL=

# --- Infra ---
QDRANT_URL=http://localhost:6333
TOKRES_DATA_DIR=./data
TOKRES_TZ=Asia/Seoul
# Identify yourself to sec.gov (required by SEC fair-access policy)
HTTP_USER_AGENT=tokres-research-agent (contact: you@example.com)

# --- Models ---
TRIAGE_MODEL=claude-haiku-4-5
ENRICH_MODEL=claude-opus-5
ANSWER_MODEL=claude-opus-5
ENRICH_DAILY_MAX=25
